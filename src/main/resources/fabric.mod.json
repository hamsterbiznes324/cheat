    "client": ["com.tgdesktop.TGDesktopClient"]
  },
  "depends": {
    "fabricloader": ">=0.18.3",
    "fabric-api": ">=0.140.2",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "rinku": ">=3.0.1"
  }
}
